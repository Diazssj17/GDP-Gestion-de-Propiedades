# Copiar a .env (NO subir .env al repositorio; esta en .gitignore)
# En Render, estas mismas variables van en la seccion Environment del servicio.

# --- App ---
SECRET_KEY=cambia_esto_por_un_valor_largo_y_aleatorio

# --- Superadmin (se crea al iniciar si no existe) ---
ADMIN_EMAIL=admin@gdp.com
ADMIN_PASSWORD=pon_una_contrasena_segura

# --- Demo (solo desarrollo; opcional) ---
# SEED_DEMO=1
# DEMO_PASSWORD=demo_segura

# --- SMTP (recuperacion de contrasena) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=tu_correo@gmail.com
SMTP_CLAVE=tu_password_de_aplicacion
BASE_URL=https://tu-app.onrender.com

# --- Wompi (pasarela de pago) ---
WOMPI_PUBLIC_KEY=pub_prod_...
WOMPI_PRIVATE_KEY=prv_prod_...
WOMPI_BASE_URL=https://production.wompi.co/v1
WOMPI_WEBHOOK_SECRET=tu_secreto_webhook

# --- WhatsApp ---
WHATSAPP_NUMERO=573156652423
